<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_card"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnSandboxClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <!-- URL bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/url_bar_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 "
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/txtSandboxUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://example.com"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Sandbox label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SANDBOX"
            android:textColor="@color/warning"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@drawable/badge_warning"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- Isolation notice -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Isolated — cookies, storage and popups are blocked"
        android:background="@color/warning_dim"
        android:textColor="@color/warning"
        android:textSize="11sp"
        android:gravity="center"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"/>

    <!-- WebView -->
    <WebView
        android:id="@+id/sandboxWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
