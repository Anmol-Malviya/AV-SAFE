<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_ios_screen"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="48dp"
        android:gravity="center_horizontal">

        <!-- 1. Header / Shield Icon with soft glowing aura -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/imgShieldWarning"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Threat Blocked Shield"
                android:src="@drawable/ios_shield_warning" />
        </FrameLayout>

        <!-- 2. Main Title -->
        <TextView
            android:id="@+id/txtWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High-Risk Threat Blocked"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="8dp" />

        <!-- 3. Subtitle / Supporting text -->
        <TextView
            android:id="@+id/txtWarningSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This link looks suspicious and may be harmful to your device and data."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="18dp" />

        <!-- 4. Safety Score Pill Badge -->
        <LinearLayout
            android:id="@+id/layoutScoreBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ios_pill_danger"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/txtScoreVerdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safety Score: 1 / 100  ·  DANGEROUS"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.01" />
        </LinearLayout>

        <!-- 5. URL Section Container (Minimal rounded card with Link icon, wrapping URL & Copy button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/ios_card_white"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:elevation="1dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/ios_circle_blue_soft"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Link icon"
                    android:src="@drawable/ic_link_blue" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtUrlBlocked"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="https://practice.expandtesting.com/login#google_vignette"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="normal" />

            <FrameLayout
                android:id="@+id/btnCopyUrl"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Copy URL"
                    android:src="@drawable/ic_copy_ios" />
            </FrameLayout>
        </LinearLayout>

        <!-- 6. Threat Explanation (Soft red background with pale-red border) -->
        <LinearLayout
            android:id="@+id/cardThreatReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/ios_card_danger"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/ios_circle_red_soft"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Warning icon"
                    android:src="@drawable/ic_warning_triangle_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Why this is blocked"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtWarningReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deceptive keywords: URL paths use security/urgency words to trick you."
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 7. Primary Action: Prominent Blue Pill Button with back arrow and chevron -->
        <LinearLayout
            android:id="@+id/btnGoBack"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ios_btn_primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="2dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Back icon"
                android:src="@drawable/ic_arrow_back_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Go Back to Safety"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Forward chevron"
                android:src="@drawable/ic_chevron_right_white" />
        </LinearLayout>

        <!-- 8. Secondary Action: Open in Restricted Sandbox -->
        <LinearLayout
            android:id="@+id/btnOpenSandbox"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ios_card_white"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="1dp"
            android:layout_marginBottom="10dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/ios_circle_blue_soft"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cube icon"
                    android:src="@drawable/ic_cube_blue" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open in Restricted Sandbox"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open in isolated, secure environment"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Arrow"
                android:src="@drawable/ic_chevron_right_gray" />
        </LinearLayout>

        <!-- 9. Report Action: Report This Link -->
        <LinearLayout
            android:id="@+id/btnReportComplaint"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ios_card_white"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="1dp"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/ios_circle_gray_soft"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Flag icon"
                    android:src="@drawable/ic_flag_gray" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report This Link"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Help us keep the web safer"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Arrow"
                android:src="@drawable/ic_chevron_right_gray" />
        </LinearLayout>

        <!-- 10. Advanced Options Toggle -->
        <LinearLayout
            android:id="@+id/layoutAdvancedToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/txtAdvancedToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advanced Options ∨"
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- 11. Dangerous Override Button (Revealed by Advanced Options) -->
        <LinearLayout
            android:id="@+id/btnIgnoreAndOpen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ios_btn_danger_outline"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="External link"
                android:src="@drawable/ic_external_red" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Open anyway (unsafe)"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Chevron"
                android:src="@drawable/ic_chevron_right_red" />
        </LinearLayout>

        <!-- iOS Bottom Indicator Bar -->
        <View
            android:layout_width="134dp"
            android:layout_height="4dp"
            android:background="#20000000"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
