<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Warning Shield Header -->
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/warning_glow">

            <TextView
                android:id="@+id/txtWarningIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨"
                android:textSize="52sp"
                android:layout_gravity="center"/>
        </FrameLayout>

        <TextView
            android:id="@+id/txtWarningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phishing Threat Blocked"
            android:textColor="@color/danger"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/txtScoreVerdict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety Score: 15 / 100 (DANGEROUS)"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtUrlBlocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="http://secure-paypal-login-update.com"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="20dp"/>

        <!-- Details Box -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Threat Details &amp; Evidence"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/txtWarningReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Brand Spoofing: Mimics Paypal official site.\n• Typosquatting: Close visual lookalike.\n• Insecure Connection: Uses HTTP."
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Primary Actions -->
        <Button
            android:id="@+id/btnGoBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Go Back to Safety"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnOpenSandbox"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Open in Restricted Sandbox"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/secondary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"/>

        <Button
            android:id="@+id/btnReportComplaint"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Generate Complaint Report"
            android:backgroundTint="@color/bg_card"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textAllCaps="false"
            style="?android:attr/borderlessButtonStyle"/>

        <TextView
            android:id="@+id/txtAdvancedToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advanced Options ▾"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnIgnoreAndOpen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Ignore warning and open in Chrome (Unsafe)"
            android:backgroundTint="@color/danger_dim"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:visibility="gone"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>
