<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_card">

    <!-- Title row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report Threat"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sent to SecOps for investigation and domain blocklisting."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_marginBottom="20dp"/>

    <!-- URL + verdict preview -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/report_info_bg"
        android:padding="14dp"
        android:layout_marginBottom="18dp">

        <TextView
            android:id="@+id/dialogComplaintTargetUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://..."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/dialogComplaintVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DANGEROUS · Score 15/100"
            android:textColor="@color/danger"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"/>
    </LinearLayout>

    <!-- Category -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CATEGORY"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="6dp"/>

    <Spinner
        android:id="@+id/spinnerCategory"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/input_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- Notes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOTES (OPTIONAL)"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/editComplaintDescription"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/input_bg"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:gravity="top|start"
        android:hint="e.g. Received via SMS, claims account suspended..."
        android:textColorHint="@color/text_muted"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp"/>

    <!-- Privacy note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Only the URL, detection findings, category, and your notes are submitted. No credentials, cookies, or form data."
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp"/>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressSubmitting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="10dp"/>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelComplaint"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginEnd="8dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnConfirmSubmitComplaint"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Submit Report"
            android:backgroundTint="@color/danger"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
