# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android Build & IDE files
/apps/android/.gradle/
/apps/android/app/build/
/apps/android/build/
/apps/android/local.properties
/apps/android/.idea/caches/
/apps/android/.idea/deploymentTargetSelector.xml
/apps/android/.idea/runConfigurations.xml
/android-app/.gradle/
/android-app/app/build/
/android-app/build/
/android-app/local.properties
/android-app/.idea/caches/
/android-app/.idea/deploymentTargetSelector.xml
/android-app/.idea/runConfigurations.xml

# ML Datasets (large archives / binaries)
*.zip
*.tar.gz
ml/datasets/PhiUSIIL_Phishing_URL_Dataset.csv
ml/datasets/processed/
ml/datasets/splits/
ml/models/checkpoints/

# System and editor files
.DS_Store
*.swp
*.swo
.update


# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Generated / trained ML artifacts (never commit model weights)
/ml/models/trained/
/ml/models/checkpoints/
/ml/models/exported/
/ml/weights/*
!/ml/weights/README.md
/src/lib/phishing_model_weights.json
