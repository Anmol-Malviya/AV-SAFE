{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web-app": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web-app"
      }
    }
  ]
}
