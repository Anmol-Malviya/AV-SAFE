{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web-app": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm install && npm --prefix web-app install",
      "buildCommand": "npm --prefix web-app run build",
      "outputDirectory": "web-app/.next"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web-app"
      }
    }
  ]
}
