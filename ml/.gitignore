# Python virtual environments
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class

# Large Raw and Processed Datasets (keep splits and raw data out of git)
data/raw/*
!data/raw/README.md
data/processed/*.parquet
data/processed/*.csv
data/splits/*.parquet
data/splits/*.csv

# Checkpoints and Heavy Model Weights
models/checkpoints/*
!models/checkpoints/.gitkeep
models/trained/*.joblib
models/trained/*.json
!models/trained/.gitkeep
models/exported/*.joblib

