# AV-SAFE Environment Configuration Example

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/phishguard?retryWrites=true&w=majority

# Administrative Security Key for /api/admin/* endpoints
ADMIN_SECRET_KEY=phishguard-secops-admin-key-2026

# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

# Next Public URL (for mobile sync and telemetry)
NEXT_PUBLIC_APP_URL=http://localhost:3000
